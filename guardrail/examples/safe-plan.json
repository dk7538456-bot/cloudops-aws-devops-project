{
  "format_version": "1.2",
  "terraform_version": "1.11.4",
  "resource_changes": [
    {
      "address": "aws_security_group.web",
      "type": "aws_security_group",
      "change": {
        "actions": ["create"],
        "after": {
          "ingress": [
            {
              "protocol": "tcp",
              "from_port": 80,
              "to_port": 80,
              "cidr_blocks": ["0.0.0.0/0"],
              "ipv6_cidr_blocks": []
            }
          ],
          "tags": {"Project": "cloudops-guard", "Environment": "demo"}
        }
      }
    },
    {
      "address": "aws_instance.app",
      "type": "aws_instance",
      "change": {
        "actions": ["create"],
        "after": {
          "metadata_options": [{"http_tokens": "required"}],
          "root_block_device": [{"encrypted": true}],
          "tags": {"Project": "cloudops-guard", "Environment": "demo"}
        }
      }
    }
  ]
}
